<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Popover
        id="installationPopover"
        title="Installation"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--footer"
        placement="Bottom">
        <f:SimpleForm id="installationSimpleForm">
            <f:content>
                <Label text="{i18n>Material}" required="true" />
                <Input id="idInstallationMatInput" value="" />
                <Label text="Storage Location" required="true" />
                <Input id="idInstallationStorageInput" value="" maxLength="4" />
            </f:content>
        </f:SimpleForm>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="Search" press=".handleInstallationSearchPress" />
            </OverflowToolbar>
        </footer>
    </Popover>
</core:FragmentDefinition>
