<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="idMovementDialog" title="Movement" draggable="true" resizable="true">
    <content>
      <VBox class="sapUiSmallMargin">
        <Label text="Storage Location" required="true"/>
        <Input id="idMovementStorageLoc" placeholder="Enter Storage Location" maxLength="4"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="Save" type="Emphasized" press="onSaveMovement"/>
    </beginButton>
    <endButton>
      <Button text="Cancel" press="onCloseMovement"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
