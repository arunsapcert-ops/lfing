<mvc:View controllerName="com.piaggio.sap.lifing.lifing.controller.ScratchCreate"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:u="sap.ui.unified" 
    xmlns:layout = "sap.ui.layout" xmlns:f="sap.ui.layout.form"  
    xmlns:t="sap.ui.table" height="100%" >
    <Page id="pagesc" title="{i18n>Create From Scratch}" titleAlignment="Center" showNavButton="true" navButtonPress="onNavButtonPress" enableScrolling="false">
		<customHeader>
			<Toolbar id="_IDGenToolbar" height="10%">
                <!-- <HBox id="_IDGenVBox1"> -->
                <HBox id="_IDGenVBox1" wrap="Wrap" fitContainer="true">
                <Button id="_IDGenButton2" icon="sap-icon://nav-back" press="onNavButtonPress" />
				 <!-- <ComboBox id="_IDGenComboBox1" selectionChange="onSelectStorageLocation" >
					<core:Item id="_IDGenItem" key="ARTS" text="Team Satellite" />
					<core:Item id="_IDGenItem1" key="ARTT" text="Test Team Apr." />
					<core:Item id="_IDGenItem2" key="ARGP" text="Team Ufficiale" />
				 </ComboBox> -->
                 <Input
					id="_IDGenComboBox1"
					maxLength="4"
                    liveChange="onStorageLocationLiveChange"
					change="onSelectStorageLocation"
					placeholder="Storage Location"
                    enabled="{= ${mList>/root}.length === 0}"
					width="8rem" />
                 <u:FileUploader id="fileUploader" name="myFileUpload" width="16rem" buttonOnly="true"
				    tooltip="Upload your file to the local server"
				    change="handleUploadPress"
                    value="{app>/selectedFileName}"
				    buttonText="Upload File" 
                    enabled = "true"/>
                    <Select
					id="_IDGenSelectLifing"
					visible="{app>/isLifingManagement}"
					selectedKey="Yes"
                    change="onLifingSelectChange"
					width="6rem">
					<core:Item id="_IDGenItem" key="Yes" text="Yes" />
					<core:Item id="_IDGenItem1" key="No" text="No" />
				 </Select>
                 <HBox id="idBomBox" width="auto" alignItems="Center" justifyContent="Center" class="sapUiTinyMarginBegin">
    				<Label id="_IDGenLabel3" text="Material: " class="sapUiSmallMarginEnd" />
				    <SearchField id="_IDGenSearchField" search=".onSearch" enabled="true" width="10rem"/>
		    	</HBox>
				 <!-- <Button id="_IDGenButton1" text="Material Check" press="onMaterialCheck" enabled="false"></Button> -->
				 <Button id="_IDGenButtonec" text="Equipment Creation" press="onEquipmentCreation" enabled="false"></Button>
				 <Button id="_IDGenButtonsave" text="Installation" press="onSaveEquipment" enabled="false"></Button>
                 <Button id="_IDGenButtondis" text="Dismantle" press="onPressDismantle" enabled="false"></Button>
                 <Button id="_IDGenButtonsno" text="Serial Number Available" press="onPressSno" enabled="true"></Button>
                 <Button id="_IDGenButtonadds" text="Add Existing Structure" press="onPressStructure" enabled="true"></Button>               
                 <Button id="idAddButton" icon="sap-icon://add" type="Transparent" press="OnAddMaterial" enabled="true"></Button>
                 <Button id="idDelButton" icon="sap-icon://delete" type="Transparent" press="OnDeleteMaterial" enabled="false"></Button>
                 <Button id="_IDGenButtonsnr" text="{i18n>Save New Run}" press="onSaveNewRun" enabled="false"></Button>
                 <Button id="_IDGenButtoninst" text="Installation" press="onInstallationPress" visible="{app>/isLifingManagement}" enabled="false"></Button>
                 <Button id="_IDGenButtonreplace" text="Replace" press="onReplacePress" visible="{app>/isLifingManagement}" enabled="false"></Button>
                 <HBox id="idKmAlertBox" visible="{app>/isLifingManagement}" alignItems="Center" class="sapUiTinyMarginBegin">
                    <Input id="idKmAlertInput" type="Number" value="{app>/kmAlert}" width="5rem" change="onKmAlertChange" tooltip="KM Allert" />
                 </HBox>
                </HBox>
			</Toolbar>
		</customHeader>
        <content>
			<!-- <VBox id="_IDGenVBox1" height= "75%"> -->
             <!-- <layout:VerticalLayout width="100%" height="100%">
            <ScrollContainer horizontal="true" vertical="true" height="100%" width="100%"> -->
                <t:TreeTable id="idscratchCreateTable"                    
                    rows="{path: 'mList>/root', parameters: {arrayNames: ['children']}}"
                    selectionMode="MultiToggle"
                    rowSelectionChange="onTableSelection"
                    width="100%"                
                    visibleRowCountMode="Auto">
                    <t:Column id="_IDGenColumn1" width="6rem" showFilterMenuEntry="true" filterProperty="fg">
                        <Label id="_IDGenLabelfg" text="Functional Group" wrapping="true"/>
                        <t:template>
                            <Input id="_IDGenfg" value="{mList>fg}" editable="{= !${mList>Equipment}}" />
                        </t:template>
                    </t:Column>
                    <!-- <t:Column id="_IDGenColumn" width="3%" showFilterMenuEntry="true" filterProperty="level">
                        <Label id="_IDGenLabel4" text="Position" wrapping="true"/>
                        <t:template>
                            <VBox id="_IDGenVBox52">
                              <Text id="_IDGenTextlev" text="{mList>level}" visible="{= !!${mList>equipment}}"/>
                              <Input id="_IDGenlev" value="{mList>Position}" visible="{= !${mList>equipment}}"/>
                            </VBox>
                        </t:template>
                    </t:Column> -->
                    <t:Column id="_IDGenColumn" width="5rem" showFilterMenuEntry="true" filterProperty="level">
                        <Label id="_IDGenLabel4" text="Position" wrapping="true"/>
                            <t:template>
                                <Input id="_IDGenlev" value="{mList>level}" editable="{= !${mList>Equipment}}"/>
                            </t:template>
                        </t:Column>
                    <t:Column id="_IDGenColumn2" width="7rem" showFilterMenuEntry="true" filterProperty="equipment">
                        <Label id="_IDGenLabeleq" text="Equipment" wrapping="true"/>
                        <t:template>
                            <Text id="_IDGenTexteq" text="{mList>Equipment}"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="_IDGenColumn3" width="6rem" showFilterMenuEntry="true" filterProperty="Material">
                        <Label id="_IDGenLabelm" text="Material" wrapping="true"/>
                        <t:template>
                            <Text id="_IDGenTextm" text="{mList>Material}"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="_IDGenColumn4" width="9rem" showFilterMenuEntry="true" filterProperty="Description">
                        <Label id="_IDGenLabeldes" text="Description" wrapping="true"/>
                        <t:template>
                            <Text id="_IDGenTextdes" text="{mList>MaterialDescription}"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="_IDGenColumn5" width="7rem" filterProperty="sNo">
                        <Label id="_IDGenLabelsn" text="Serial Number" wrapping="true"/>
                        <t:template>
                            <!-- <Input id="_IDGenIp" value="{mList>isNo}"/> -->
                            <VBox id="_IDGenVBox5">
                               <Input id="_IDGenIp" value="{mList>sNo}" editable="{= !${mList>Equipment}}"/>
                            </VBox>
                            <!-- <Text id="_IDGenTextsn" text="{mList>sNo}"/> -->
                        </t:template>
                    </t:Column>
                    <t:Column id="_IDGenColumn6" width="6rem">
                        <Label id="_IDGenLabelkm" text="Note" wrapping="true"/>
                        <t:template>
                            <!-- <Input id="_IDGenTextkm" value="{mList>km}"/> value="{= ${mList>Note} === undefined ? 'undefined' : ${mList>Note} }" value="{mList>Note}" visible="{= !${mList>Equipment}}" -->
                            <VBox id="_IDGenVBox6">
                              <!-- <Text id="_IDGenTextkm" text="{mList>km}" visible="{= !!${mList>Equipment}}"/> -->
                              <Input id="_IDGenkm" value="{mList>Note}" editable="{= !${mList>Equipment}}"/>
                            </VBox>
                            <!-- <Text id="_IDGenTextkm" text="{mList>km}"/> -->
                        </t:template>
                    </t:Column>
                    <!-- <t:Column id="_IDGenColumn7" width="3%" showFilterMenuEntry="true" filterProperty="Revisione">
                        <Label id="_IDGenLabelrev" text="Revisione" wrapping="true"/>
                        <t:template>
                            <Text id="_IDGenTextrev" text="{mList>KmRevisione}"/>
                        </t:template>
                    </t:Column> -->
                    <t:Column id="_IDGenColumn71" width="7rem" showFilterMenuEntry="true" filterProperty="Revisione">
                        <Label id="_IDGenLabelrevn" text="Revision Number" wrapping="true"/>
                        <t:template>
                            <Text id="_IDGenTextrevnu" text="{mList>RevisionNumber}"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="_IDGenColumn72" width="5rem" showFilterMenuEntry="true" filterProperty="Revisione">
                        <Label id="_IDGenLabelrevkm" wrapping="true" text="Km after last revision"/>
                        <t:template>
                            <Text id="_IDGenTextrevkm" text="{mList>RevisionKm}"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="_IDGenColumn722" width="5rem" showFilterMenuEntry="true" filterProperty="Revisione">
                        <Label id="_IDGenLabelrevkm2" wrapping="true" text="Revision KM"/>
                        <t:template>
                            <Text id="_IDGenTextrevkm2" text="{mList>Revisione}"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="_IDGenColumn9" width="4rem" showFilterMenuEntry="true" filterProperty="max">
                        <Label id="_IDGenLabelmax" text="MAX" wrapping="true"/>
                        <t:template>
                            <Text id="_IDGenTextmax" text="{mList>max}"/>
                        </t:template>
                    </t:Column>                    
                    <t:Column id="_IDGenColumn8" width="4rem" showFilterMenuEntry="true" filterProperty="min">
                        <Label id="_IDGenLabelmin" text="MIN" wrapping="true"/>
                        <t:template>
                            <Text id="_IDGenTextmin" text="{mList>min}"/>
                        </t:template>
                    </t:Column>                    
                    
                     
<t:Column id="_IDGenColumnKm" width="4rem" visible="false" showFilterMenuEntry="true" filterProperty="Km">
    <Label id="_IDGenLabel5" text="Km" wrapping="false"/>
    <t:template>
        <Text id="_IDGenText15" text="{mList>Km}" />
    </t:template>
</t:Column>


<t:Column id="_IDGenColumnNextRun" width="4rem" visible="false" showFilterMenuEntry="true" filterProperty="NextRun">
    <Label id="_IDGenLabel6" text="Next Run" wrapping="true"/>
    <t:template>
        <Text id="_IDGenText17" text="{mList>NextRun}" />
    </t:template>
</t:Column>


<t:Column id="_IDGenColumnKmNextRun" width="4rem" visible="false" showFilterMenuEntry="true" filterProperty="KmNextRun">
    <Label id="_IDGenLabel7" text="Km Next Run" wrapping="true"/>
    <t:template>
        <Text id="_IDGenText18" text="{mList>KmNextRun}" />
    </t:template>
</t:Column>

<!-- <t:Column id="_IDGenColumnTraffic" width="3rem" showFilterMenuEntry="true" filterProperty="TrafficLight">
    <Label id="_IDGenLabel8" text="Status" />
    <t:template>
         <core:Icon id="_IDGenIcon2"
            src="{
                = ${mList>TrafficLight} === 'G' ? 'sap-icon://status-positive' :
                  ${mList>TrafficLight} === 'Y' ? 'sap-icon://status-critical' :
                  'sap-icon://status-negative'
            }"
            color="{
                = ${mList>TrafficLight} === 'G' ? 'Green' :
                  ${mList>TrafficLight} === 'Y' ? 'Yellow' :
                  'Red'
            }"
        />         
    </t:template>
</t:Column> -->

<t:Column id="_IDGenColumnTraffic" width="4rem"
          showFilterMenuEntry="true" filterProperty="TrafficLight">
    <Label id="_IDGenLabel8" text="Status" />
    <t:template>
        <core:Icon id="_IDGenIcon2"
                   src="{mList>TrafficIcon}"
                   color="{mList>TrafficColor}" />
    </t:template>
</t:Column>



<t:Column id="_IDGenColumnfb" width="7rem" visible="true" showFilterMenuEntry="true" filterProperty="fb">
                        <Label id="_IDGenLabelfb" text="Feedback" wrapping="true"/>
                        <t:template>
                           <VBox id="_IDGenVBox3">
                             <!-- <Text id="_IDGenText16" text= "{mList>fbMessage}" visible="{= ${mList>fb} !== 'OK'}" /> -->
                             <ObjectStatus id="_IDGenText16" 
                                   text="{mList>fbMessage}" 
                                   visible="{= ${mList>fb} !== 'OK'}"
                                   state="{= ${mList>fbMessage} === 'Installed' ? 'Success' : ${mList>fbMessage} === 'Dismantled' ? 'Error' : 'None'}"/>
                                   <!-- state="{= ${mList>fbMessage} === 'Installed' ? 'Success' : 'None'}"/> -->
                             <core:Icon id="_IDGenIcon" src="sap-icon://accept" visible="{= ${mList>fb} === 'OK'}"/>
                           </VBox>
                        </t:template>
                    </t:Column>

                    <t:Column id="_IDGenColumnedb" width="4rem">
                        <Label id="_IDGenLabeledb" text="" wrapping="true"/>
                        <t:template>
                          <HBox id="_IDGenHBox1">
                           <Button id="idEditButton" icon="sap-icon://edit" type="Transparent" press="OnEditMaterial" visible="{= !!${mList>Equipment}}">
                           </Button>
                           <!-- <Button id="idRevButton" icon="sap-icon://project-definition-triangle" type="Transparent" visible="{= !!${mList>Equipment}}" tooltip="Revision" press="OnRevisionPress">
                           </Button> -->
                          </HBox> 
                        </t:template>
                    </t:Column>

                    <t:Column id="_IDGenColumneedb" width="4rem">
                        <Label id="_IDGenLabeleedb" text="" wrapping="true"/>
                        <t:template>
                          <HBox id="_IDGenHBox11">
                            <Button id="idRevButton" icon="sap-icon://project-definition-triangle" type="Transparent" visible="{= !!${mList>Equipment}}" tooltip="Revision" press="OnRevisionPress">
                           </Button>
                          </HBox> 
                        </t:template>
                    </t:Column>
                   

                </t:TreeTable>
                <!-- </ScrollContainer>
                </layout:VerticalLayout> -->
			<!-- </VBox> -->
        </content>
    </Page>
</mvc:View>